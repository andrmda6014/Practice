<Window x:Class="Task10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Task10"
    Title="ImageTimer" Height="400" Width="600">
    <StackPanel>
        <local:Timer x:Name="ImageTimer" Width="300" Height="300" />
        <Button Content="Следующая картинка" Click="NextImage_Click" />
        <TextBox x:Name="IntervalTextBox" Text="1000" />
        <Button Content="Применить" Click="Apply_Click" />
        <Button Content="Старт/Стоп" Click="StartStop_Click" />
    </StackPanel>
</Window>
